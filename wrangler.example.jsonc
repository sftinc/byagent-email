{
  "name": "agent-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Stores logs for 3 days (free) or 7 (paid), so a webhook that failed unattended can still be
  // read afterwards. Sampling applies per invocation, so keep the rate at 1 or lose whole deliveries.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "RETENTION_DAYS": "0", // days to keep mail, sent and received; "0" keeps it forever
    "API_URL": "" // the Worker's own URL, set by setup; attachment links are minted under it
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-inbox",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "agent-inbox" }],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "agent-inbox-webhooks" }],
    "consumers": [
      { "queue": "agent-inbox-webhooks", "max_retries": 4 },
      { "queue": "agent-inbox-email-events", "max_retries": 4 }
    ]
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
