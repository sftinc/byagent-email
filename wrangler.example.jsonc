{
  "name": "agent-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "RETENTION_DAYS": "0" // days to keep received mail; "0" keeps it forever
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-inbox",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "agent-inbox" }],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "agent-inbox-webhooks" }],
    "consumers": [{ "queue": "agent-inbox-webhooks", "max_retries": 4 }]
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
